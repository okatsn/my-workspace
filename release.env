# The only file to edit for a version bump; every tag and derived value comes from shscripts/release_vars.sh.
# An image tag `<name>.<REV>` is immutable: to rebuild the same release, bump its REV.

# Julia -> okatsn/my-julia-build:v<major>.<minor>-<RELEASE>.<REV>
JULIA_VERSION=1.13.1
JULIA_RELEASE=2026e
JULIA_REV=0

# Quarto -> okatsn/my-quarto-build:v<major>.<minor>-<RELEASE>.<REV>
QUARTO_VERSION=1.10.18
QUARTO_RELEASE=2026e
QUARTO_REV=0

# Typst -> okatsn/my-typst-space:v<major>.<minor>-<RELEASE>.<REV> (mirrored from ghcr.io/typst/typst:<VERSION>, not built)
TYPST_VERSION=0.15.1
TYPST_RELEASE=2026e
TYPST_REV=0

# Jupyter workspace -> okatsn/my-jupyter-with-julia:v<RELEASE>.<REV>
# The FROM line of my-jupyter-with-julia/.devcontainer/Dockerfile must be this immutable tag.
JUPYTER_RELEASE=2026e
JUPYTER_REV=0
