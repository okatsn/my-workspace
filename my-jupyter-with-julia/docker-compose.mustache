# # Instruction
# - assign a new image name
# - make this file consistent with that in https://github.com/okatsn/MyTeXLife

services:
  # The service name should be consistent with that in devcontainer.json
  {{service}}:
    build:
      context: ..
      #     That is out of /.devcontainer
      # context: .
      #     That is /.devcontainer
      dockerfile: .devcontainer/Dockerfile

    # Better not to have duplicate image name
    image: {{image}}
    init: true
    # See https://docs.docker.com/compose/compose-file/compose-file-v3/#init

    # Better not to have duplicate container name. Error "Conflict will occur if another. The container name "/tex-with-julia" is already in use by container" might occur if there is another container of the same name is currently running.
    container_name: {{docker_compose_name}}
    {{#dind}}
    privileged: true  # WARNING: Allow Docker operations (using `docker` via dind). Very dangerous for agentic coding since it allow agent to do anything on host machine
    {{/dind}}
    volumes:
      # # The home directory is called "workspace"; try `cd ..` and `ls` to figure it out.
      - ..:/home/jovyan/workspace
      {{^dind}}
      # # WARNING: Docker socket to access Docker server
      # Docker command run inside the container actually communicates with the Docker engine on your host machine. This theoretically allows a malicious agent to grant root accessibility to your host machine by creating a new container and mounted it to the entire hard drive.
      # - /var/run/docker.sock:/var/run/docker.sock
      {{/dind}}
      # # WARNING: Forwarding `.ssh`, `.gitconfig` and `pydrive2fs` (DVC token) allows agents in container to run `git push origin --delete` or `dvc gc -T`.
      # # WARNING: SSH directory
      # - ~/.ssh:/home/jovyan/.ssh
      # # For Windows without WSL, a copy will be made from /tmp/.ssh to ~/.ssh to fix permissions
      # - ~/.ssh:/tmp/.ssh:ro
      # # Copilot (Agent Host) customizations from okatsn/my-agents; see MIGRATION-PLAN.md
      # KEYNOTE:
      # - ~/.copilot is a private, writable named volume (state, sessions, logs); only the selected customization directories below are bind-mounted read-only over it.
      # - Keep ~/.copilot/instructions free of anything but these mount targets; leftovers in the volume would also be discovered.
      # - `create_host_path: false` makes compose fail instead of silently creating a missing host directory. `.devcontainer/preflight.sh` (initializeCommand) also checks the sources before start.
      - type: volume
        source: copilot-state
        target: /home/jovyan/.copilot
      # Custom agents (flat directory; all are exposed)
      - type: bind
        source: ${HOME:?HOME is required}/projects/my-agents/copilot/agents
        target: /home/jovyan/.copilot/agents
        read_only: true
        bind:
          create_host_path: false
      # Instruction families selected for this project (add/remove in sync with preflight.sh)
      - type: bind
        source: ${HOME:?HOME is required}/projects/my-agents/copilot/instructions/common
        target: /home/jovyan/.copilot/instructions/common
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: ${HOME:?HOME is required}/projects/my-agents/copilot/instructions/julia
        target: /home/jovyan/.copilot/instructions/julia
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: ${HOME:?HOME is required}/projects/my-agents/copilot/instructions/shell
        target: /home/jovyan/.copilot/instructions/shell
        read_only: true
        bind:
          create_host_path: false
      # Skill sets are discovered through COPILOT_SKILLS_DIRS (see `environment`); each set is a skill discovery root, i.e., skills sit directly beneath it.
      - type: bind
        source: ${HOME:?HOME is required}/projects/my-agents/copilot/skillsets/typst
        target: /home/jovyan/skillsets/typst
        read_only: true
        bind:
          create_host_path: false
      # # WARNING: Git config
      # - ~/.gitconfig:/home/jovyan/.gitconfig
      # # Persistent volumes for this container; Avoid reinstall vscode extensions
      - julia-depot:/home/jovyan/.julia
      # # KEYNOTE:
      # # - Named volumes is chosen because VSCode extensions of this environment is not expected to be shared with those in WSL.
      # # - Please refer to okatsn/MyTeXLife for more explanation
      - vscode-server:/home/jovyan/.vscode-server
      # # WARNING: DVC credential cache directory (this makes DVC credential persistant)
      # - ~/.cache/pydrive2fs:/home/jovyan/.cache/pydrive2fs
      {{#dind}}
      - /usr/bin/docker:/usr/bin/docker  # Add this to access docker binary; otherwise, permission denied when using docker in this docker container (DinD).
    depends_on:
      # (Docker in Docker, DinD)
      dind-{{service}}:
        condition: service_started  # Make this explicit
      {{/dind}}
    environment:
      {{#dind}}
      # # Use http to connect with the other container
      - DOCKER_HOST=tcp://dind:2375  # Add this to connect to DinD
      {{/dind}}
      # Set time zone (GMT-8 is UTC+8):
      # - To print available time-zone names: ls /usr/share/zoneinfo
      - TZ=Etc/GMT-8
      - COPILOT_HOME=/home/jovyan/.copilot
      # Comma-separated skill discovery roots (no spaces)
      - COPILOT_SKILLS_DIRS=/home/jovyan/skillsets/typst
    entrypoint: sh -c "sleep infinity"

{{#dind}}
  # # Use a sibling container to run docker in a docker container (Docker in Docker, DinD)
  # - Set up `dind` where `docker` is inherently available, that can be used via tcp protocol by the service that depends on it.
  # Referring: https://gemini.google.com/app/3c8f232c01664a56
  # KEYNOTE: there is no need to install docker in Dockerfile!
  dind-{{service}}:
    image: docker:dind
    privileged: true # dind needs privileged mode
    environment:
      # # When empty, it use http to connect with the other container
      - DOCKER_TLS_CERTDIR=
      # # Use https to connect with the other container
      # - DOCKER_TLS_CERTDIR=/certs
    volumes:
      # KEYNOTE: The Docker client in your dev container connects to the DinD Docker daemon (running in a separate container). When you use --volume "$PWD:/data" inside the dev container (where $PWD is “/workspace”), that path is being interpreted relative to the file system of the DinD container. To make uses of data and files in your working directory, you have to add the same bind mount for your workspace.
      - ../:/home/jovyan/workspace
      - dind-data:/var/lib/docker
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G  # Give dind less, as it mostly manages other containers
        reservations:
          cpus: '0.25'
          memory: 256M
    command: --host=tcp://0.0.0.0:2375
    # Add this to expose Docker API
{{/dind}}

# KEYNOTE: Those defined volumes in service should be declared in the root level
# Unbind vscode-server to volumes to ensure extensions in devcontainer.json to be installed on rebuild
volumes:
  julia-depot:
  vscode-server:
  # Per-project Copilot state; `docker compose down -v` deletes it.
  copilot-state:
  {{#dind}}
  dind-data:
  {{/dind}}